# --- Base de datos (Supabase, proyecto jwt-auth-backend: afjjmrymllslbvwysbij) ---
# Opción A (IPv6): conexión directa
# DATABASE_URL=postgresql+asyncpg://postgres:TU_PASSWORD@db.afjjmrymllslbvwysbij.supabase.co:5432/postgres
# Opción B (IPv4): Session pooler, copia el host exacto desde Dashboard > Connect
# DATABASE_URL=postgresql+asyncpg://postgres.afjjmrymllslbvwysbij:TU_PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:TU_PASSWORD@db.afjjmrymllslbvwysbij.supabase.co:5432/postgres

# --- JWT ---
# Genera uno: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CAMBIA_ESTO_por_un_secreto_largo_de_al_menos_32_caracteres
JWT_ALGORITHM=HS256
JWT_ISSUER=jwt-auth-backend
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# --- Seguridad ---
MAX_FAILED_ATTEMPTS=5
LOCKOUT_MINUTES=15
REQUIRE_EMAIL_VERIFICATION=true
BCRYPT_ROUNDS=12

# --- Solo desarrollo: devuelve los tokens de verificación/reset en la respuesta
# (no hay servicio de email integrado). En producción debe ser false.
DEV_EXPOSE_TOKENS=true

# Lista JSON de orígenes permitidos por CORS
CORS_ORIGINS=["http://localhost:4200", "http://localhost:3000"]
